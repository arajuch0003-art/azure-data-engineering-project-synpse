				"source": [
					"# 1. Silver Layer (Parquet) నుండి డేటాని చదవడం\n",
					"silver_df = spark.read.parquet(\"abfss://main@rgsynapsedev01.dfs.core.windows.net/transformed-silver/Customer.parquet\")\n",
					"\n",
					"# 2. Gold Layer Transformation: Country-wise Total Customers ని లెక్కించడం\n",
					"from pyspark.sql.functions import count\n",
					"\n",
					"gold_df = silver_df.groupBy(\"Country\").agg(count(\"CustomerID\").alias(\"TotalCustomers\"))\n",
					"\n",
					"# 3. Gold Layer (curated) ఫోల్డర్‌లో Parquet ఫార్మాట్‌లో దాచడం\n",
					"gold_df.write.mode(\"overwrite\").parquet(\"abfss://main@rgsynapsedev01.dfs.core.windows.net/curated/country_customer_summary.parquet\")\n",
					"\n",
					"# 4. ఫలితాన్ని డిస్‌ప్లే చేయడం\n",
					"display(gold_df)"
				],
				"execution_count": 1
			}
		]
