			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "-- This is auto-generated code\nSELECT\n    TOP 100 *\nFROM\n    OPENROWSET(\n        BULK 'https://rgsynapsedev01.dfs.core.windows.net/main/transformed-silver/Customer.parquet',\n        FORMAT = 'PARQUET'\n    ) AS [result]\n",
